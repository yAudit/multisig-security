# Etherscan API Key
# Get your free API key at: https://etherscan.io/apis
# This is used for fetching contract verification status and transaction data
NEXT_PUBLIC_ETHERSCAN_API_KEY=YourApiKeyToken

# Optional: Additional API keys for other explorers if needed
# NEXT_PUBLIC_ARBISCAN_API_KEY=
# NEXT_PUBLIC_OPTIMISTIC_ETHERSCAN_API_KEY=
# NEXT_PUBLIC_BASESCAN_API_KEY=
# NEXT_PUBLIC_POLYGONSCAN_API_KEY=
# NEXT_PUBLIC_BSCSCAN_API_KEY=

# Optional: Override the primary RPC endpoint for each supported chain
# RPC_URL_ETHEREUM= # optional
# RPC_URL_BASE= # optional
# RPC_URL_ARBITRUM= # optional
# RPC_URL_OPTIMISM= # optional
# RPC_URL_POLYGON= # optional
# RPC_URL_BNB= # optional
# RPC_URL_SONIC= # optional
# RPC_URL_KATANA= # optional
